{
  "name": "defikarta",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "web": "npm run dev -w @defikarta/web",
    "server": "npm run start -w @defikarta/server",
    "mobile": "npm run start -w @defikarta/mobile",
    "test": "npm test -w @defikarta/core",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "overrides": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  }
}
