{
  "expo": {
    "name": "ДефиКарта",
    "slug": "defikarta",
    "scheme": "defikarta",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "bg.defikarta.app"
    },
    "android": {
      "package": "bg.defikarta.app",
      "adaptiveIcon": {
        "backgroundColor": "#C8102E",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "VIBRATE",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ],
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      "expo-audio",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "ДефиКарта използва местоположението ти, за да покаже най-близкия дефибрилатор и — ако си доброволец и си „достъпен“ — за известия наблизо."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
